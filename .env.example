# Names only. Real values go in .env (git-ignored). Never commit secrets.
# fake (default, offline) | gemini | github | foundry
# gemini = Google's native generateContent API. This code sends NO key: run it where a network
# proxy adds the credential, or add your own auth outside the repo. Model: GEMINI_MODEL
# (default gemini-3.5-flash, falls back to gemini-flash-latest on 429/5xx).
LLM_PROVIDER=fake
GEMINI_MODEL=
GITHUB_TOKEN=
FOUNDRY_ENDPOINT=
FOUNDRY_KEY=
COSMOS_ENDPOINT=
COSMOS_KEY=
LLM_DAILY_CALL_CAP=120
LLM_RUN_CALL_CAP=60
